{
  "name": "epicfarma-control-stock",
  "version": "2.0.0",
  "description": "Control de Stock y Vencimientos - EpicFarma",
  "main": "electron/main.js",
  "scripts": {
    "build:frontend": "cd frontend && npm run build",
    "start": "npm run build:frontend && electron .",
    "app": "electron .",
    "backend": "node scripts/electron-node.js backend/src/server.js",
    "test": "node scripts/electron-node.js --test backend/test/",
    "lint": "cd frontend && npm run lint",
    "muestras": "electron scripts/generar-muestras.js",
    "dist": "npm run build:frontend && electron-builder --win"
  },
  "build": {
    "appId": "com.epicfarma.controlstock",
    "productName": "Control de Stock EpicFarma",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Control de Stock"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/src",
        "to": "backend/src"
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*",
      "**/node_modules/better-sqlite3/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^5.2.1"
  }
}